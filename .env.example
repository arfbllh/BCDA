APP_ENV=development
SECRET_KEY=change-me

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=cancer_db
MYSQL_DB_TEST=cancer_db_test

ITEMS_PER_PAGE=20
API_MAX_CLINICAL_ROWS=500
API_CLINICAL_DEFAULT_LIMIT=200
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_ECHO=false
CORS_ORIGINS=*
MATRIX_STORAGE_DIR=./storage/matrix
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CACHE_TTL_SECONDS=300

# Optional Kafka (ingestion events; see infra/docker/docker-compose.kafka.yml)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_INGESTION_TOPIC=ingestion.events
KAFKA_DLQ_TOPIC=ingestion.dlq
KAFKA_CLIENT_ID=bcancerportal-ingestion

# Optional LLM / GPU inference (OpenAI-compatible API; see ADR-0007)
LLM_INFERENCE_ENABLED=false
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512

# Docker Compose (infra/docker/docker-compose.yml): use MYSQL_HOST=mysql,
# REDIS_URL=redis://redis:6379/0, and matching CELERY_* URLs.

