# Copy to .env.local (Create React App reads REACT_APP_* from frontend/.env*)
# Default when unset: /api/v1 (works with package.json "proxy" -> Flask :4000)

# REACT_APP_API_BASE_URL=/api/v1

# Production or API on another host (no CRA proxy):
# REACT_APP_API_BASE_URL=https://api.example.com/api/v1

# Docker Compose optional `web` profile (infra/docker/docker-compose.yml --profile web):
# CRA is built with REACT_APP_API_BASE_URL=http://localhost:4000/api/v1 so the browser on
# the host can reach the published API port. Set API CORS_ORIGINS to include your UI origin.
